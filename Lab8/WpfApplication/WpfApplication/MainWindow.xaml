<Window x:Class="WpfApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApplication"
        Title="Animated 3D Balls"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Canvas Background="Transparent">

        <!-- ====================  BALL 1 – Red (R=300) ==================== -->
        <Grid Width="600" Height="600"
                    Canvas.Left="660" Canvas.Top="-60"
                    Background="#01FFFFFF"
                    MouseEnter="Viewport_MouseEnter"
                    MouseLeave="Viewport_MouseLeave"
                    MouseLeftButtonDown="Viewport_MouseLeftButtonDown">
            <Viewport3D
                local:Ball3D.Radius="300"
                local:Ball3D.CenterX="960" local:Ball3D.CenterY="240">
                <Viewport3D.Camera>
                    <PerspectiveCamera Position="0,0,1200" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="45"/>
                </Viewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <DirectionalLight Color="White" Direction="-1,-1,-1"/>
                            <DirectionalLight Color="White" Direction="1,1,-1"/>
                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <!-- IMPORTANT: x:Name matches the code-behind lookup -->
                                    <MeshGeometry3D x:Name="Ball1Mesh"/>
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material><DiffuseMaterial Brush="Red"/></GeometryModel3D.Material>
                                <GeometryModel3D.Transform><TranslateTransform3D x:Name="Ball1Translate"/></GeometryModel3D.Transform>
                            </GeometryModel3D>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <Viewport3D.Triggers>
                    <EventTrigger RoutedEvent="Viewport3D.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <!-- X (16 keyframes, 8 s) -->
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ball1Translate"
                                                               Storyboard.TargetProperty="OffsetX"
                                                               Duration="0:0:8">
                                    <LinearDoubleKeyFrame Value="300" KeyTime="0:0:0"/>
                                    <LinearDoubleKeyFrame Value="277" KeyTime="0:0:0.5"/>
                                    <LinearDoubleKeyFrame Value="212" KeyTime="0:0:1"/>
                                    <LinearDoubleKeyFrame Value="115" KeyTime="0:0:1.5"/>
                                    <LinearDoubleKeyFrame Value="0"   KeyTime="0:0:2"/>
                                    <LinearDoubleKeyFrame Value="-115" KeyTime="0:0:2.5"/>
                                    <LinearDoubleKeyFrame Value="-212" KeyTime="0:0:3"/>
                                    <LinearDoubleKeyFrame Value="-277" KeyTime="0:0:3.5"/>
                                    <LinearDoubleKeyFrame Value="-300" KeyTime="0:0:4"/>
                                    <LinearDoubleKeyFrame Value="-277" KeyTime="0:0:4.5"/>
                                    <LinearDoubleKeyFrame Value="-212" KeyTime="0:0:5"/>
                                    <LinearDoubleKeyFrame Value="-115" KeyTime="0:0:5.5"/>
                                    <LinearDoubleKeyFrame Value="0"   KeyTime="0:0:6"/>
                                    <LinearDoubleKeyFrame Value="115" KeyTime="0:0:6.5"/>
                                    <LinearDoubleKeyFrame Value="212" KeyTime="0:0:7"/>
                                    <LinearDoubleKeyFrame Value="277" KeyTime="0:0:7.5"/>
                                    <LinearDoubleKeyFrame Value="300" KeyTime="0:0:8"/>
                                </DoubleAnimationUsingKeyFrames>
                                <!-- Y -->
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ball1Translate"
                                                               Storyboard.TargetProperty="OffsetY"
                                                               Duration="0:0:8">
                                    <LinearDoubleKeyFrame Value="0"   KeyTime="0:0:0"/>
                                    <LinearDoubleKeyFrame Value="115" KeyTime="0:0:0.5"/>
                                    <LinearDoubleKeyFrame Value="212" KeyTime="0:0:1"/>
                                    <LinearDoubleKeyFrame Value="277" KeyTime="0:0:1.5"/>
                                    <LinearDoubleKeyFrame Value="300" KeyTime="0:0:2"/>
                                    <LinearDoubleKeyFrame Value="277" KeyTime="0:0:2.5"/>
                                    <LinearDoubleKeyFrame Value="212" KeyTime="0:0:3"/>
                                    <LinearDoubleKeyFrame Value="115" KeyTime="0:0:3.5"/>
                                    <LinearDoubleKeyFrame Value="0"   KeyTime="0:0:4"/>
                                    <LinearDoubleKeyFrame Value="-115" KeyTime="0:0:4.5"/>
                                    <LinearDoubleKeyFrame Value="-212" KeyTime="0:0:5"/>
